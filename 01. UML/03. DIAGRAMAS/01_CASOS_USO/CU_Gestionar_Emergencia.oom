<a:ModificationDate>1793407199</a:ModificationDate>
<a:Modifier>vanne</a:Modifier>
<a:Description>Acceso seguro al modulo de emergencia.</a:Description>
</o:UseCase>
<o:UseCase Id="o38">
<a:ObjectID>E57EC646-8A8D-4847-8CB9-457A3E93EBB9</a:ObjectID>
<a:Name>Gestionar Emergencia</a:Name>
<a:Code>CU_GESTIONAR_EMERGENCIA</a:Code>
<a:CreationDate>1793407199</a:CreationDate>
<a:Creator>vanne</a:Creator>
<a:ModificationDate>1793407199</a:ModificationDate>
<a:Modifier>vanne</a:Modifier>
<a:Description>Gestion del flujo y atencion de pacientes en urgencias hospitalarias.</a:Description>
</o:UseCase>
<o:UseCase Id="o39">
<a:ObjectID>73F0CDAD-3CD9-455E-AB3D-721AF3F05D61</a:ObjectID>
<a:Name>Dar Alta o Derivar</a:Name>
<a:Code>CU_DAR_ALTA_DERIVAR</a:Code>
