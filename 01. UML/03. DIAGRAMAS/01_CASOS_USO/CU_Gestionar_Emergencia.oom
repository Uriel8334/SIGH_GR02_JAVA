<a:Creator>vanne</a:Creator>
<a:ModificationDate>1793407199</a:ModificationDate>
<a:Modifier>vanne</a:Modifier>
<a:Description>Accion final donde el medico cierra el episodio indicando si el paciente se va a casa o se deriva al modulo de &#39;Gestionar Hospitalizacion&#39;.</a:Description>
</o:UseCase>
<o:UseCase Id="o40">
<a:ObjectID>F975920A-AA17-4D76-B65A-075FA175070B</a:ObjectID>
