<o:UseCase Id="o36">
<a:ObjectID>DE52DBCC-66F7-4D61-9B1E-7432A5B130AC</a:ObjectID>
<a:Name>Buscar Paciente</a:Name>
<a:Code>CU_BUSCAR_PACIENTE</a:Code>
<a:CreationDate>1793407199</a:CreationDate>
<a:Creator>vanne</a:Creator>
<a:ModificationDate>1793407199</a:ModificationDate>
<a:Modifier>vanne</a:Modifier>
<a:Description>Buscar paciente o registrar un Paciente Temporal/NN si llega inconsciente o sin identificacion.</a:Description>
</o:UseCase>
<o:UseCase Id="o37">
<a:ObjectID>35AF990E-426A-4E74-B675-8E209DCA5EBB</a:ObjectID>
<a:Name>Ingresar al Sistema</a:Name>
